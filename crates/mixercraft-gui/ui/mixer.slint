import { Theme } from "theme.slint";
import { LedMeter, Fader, IndicatorButton, Knob, DeviceSelect } from "controls.slint";
import { LineEdit } from "std-widgets.slint";

export struct StripView {
    name: string,
    // Name of the device in use (or "None" / "Default …").
    device: string,
    pos: float,
    db: float,
    db-text: string,
    mute: bool,
    solo: bool,
    // Strips only: noise suppression on.
    denoise: bool,
    // Buses only: this bus clocks the engine and cannot be removed.
    master: bool,
    // Buses only: keep-awake tone on.
    keep-awake: bool,
    routes: [bool],
    // Processing knob positions, 0..1 (see src/fx_law.rs).
    gate: float,
    comp: float,
    low: float,
    mid: float,
    high: float,
}

export struct MeterView {
    l: float,
    r: float,
    lp: float,
    rp: float,
}

// Strip card: a header with the name and the device picker, then the body.
// Right-click (or double-click) the name, or right-click the fader, to rename
// or remove the strip.
component StripFrame inherits Rectangle {
    in property <string> name;
    in property <string> device;
    in property <[string]> device-options;
    in property <bool> removable: true;
    // "input" or "output", for the menu text.
    in property <string> kind: "input";
    callback device-selected(int);
    callback rename(string);
    callback remove();
    property <bool> confirm-remove;
    public function edit() {
        self.confirm-remove = false;
        editor.show();
    }
    border-radius: Theme.radius;
    background: Theme.strip;
    border-width: 1px;
    border-color: Theme.strip-border;
    VerticalLayout {
        padding: 1px;
        spacing: 0px;
        Rectangle {
            vertical-stretch: 0;
            background: Theme.strip-header;
            border-top-left-radius: Theme.radius - 1px;
            border-top-right-radius: Theme.radius - 1px;
            VerticalLayout {
                padding: 8px;
                padding-top: 9px;
                spacing: 7px;
                Text {
                    text: root.name;
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: name-touch.has-hover ? Theme.accent : Theme.text;
                    horizontal-alignment: center;
                    overflow: elide;
                    name-touch := TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                root.edit();
                            }
                        }
                        double-clicked => { root.edit(); }
                    }
                }
                DeviceSelect {
                    text: root.device;
                    options: root.device-options;
                    a11y-label: root.name + " device";
                    selected(i) => { root.device-selected(i); }
                }
            }
        }
        VerticalLayout {
            padding: 9px;
            spacing: 10px;
            @children
        }
    }
    editor := PopupWindow {
        x: 4px;
        y: 36px;
        width: max(root.width - 8px, 240px);
        height: 132px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.strip-border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text { text: "Rename " + root.kind; font-size: Theme.font-small; color: Theme.text-dim; }
                name-edit := LineEdit {
                    text: root.name;
                    init => {
                        self.focus();
                        self.select-all();
                    }
                    accepted(t) => {
                        root.rename(t);
                        editor.close();
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    if root.removable: IndicatorButton {
                        text: root.confirm-remove ? "Really remove?" : "Remove";
                        a11y-label: "Remove " + root.name;
                        on: root.confirm-remove;
                        on-color: Theme.red;
                        on-bg: Theme.red-bg;
                        clicked => {
                            if (root.confirm-remove) {
                                root.remove();
                                editor.close();
                            } else {
                                root.confirm-remove = true;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IndicatorButton {
                        text: "Save";
                        on: true;
                        clicked => {
                            root.rename(name-edit.text);
                            editor.close();
                        }
                    }
                }
            }
        }
    }
}

// The "+" card at the end of a section.
component AddCard inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: 58px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.strip-border;
    background: touch.has-hover ? Theme.strip : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding: 4px;
        Text {
            text: "+";
            font-size: 30px;
            color: touch.has-hover ? Theme.accent : Theme.text-dim;
            horizontal-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Theme.font-small;
            color: Theme.text-dim;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component InputStrip inherits StripFrame {
    in property <StripView> data;
    in property <MeterView> meter;
    in property <[string]> bus-ids;
    callback gain(float);
    callback mute();
    callback solo();
    callback route(int);
    // kind: 0 gate, 1 compressor, 2 low, 3 mid, 4 high; value 0..1.
    callback fx(int, float);
    callback denoise();
    // Noise suppression works at the engine's sample rate (48 kHz).
    in property <bool> denoise-available: true;
    width: 164px;
    name: root.data.name;
    device: root.data.device;
    function eq-text(v: float) -> string {
        abs(v * 24 - 12) < 0.25 ? "0 dB" : ((v * 24 - 12 > 0 ? "+" : "") + round((v * 24 - 12) * 2) / 2 + " dB")
    }
    HorizontalLayout {
        alignment: space-around;
        vertical-stretch: 0;
        Knob {
            size: 40px;
            label: "Gate";
            value: root.data.gate;
            default-value: 0;
            active: root.data.gate > 0.005;
            value-text: root.data.gate < 0.005 ? "off" : round(-80 + 70 * root.data.gate) + " dB";
            a11y-label: root.data.name + " gate threshold";
            a11y-value: -80 + 70 * root.data.gate;
            a11y-min: -80;
            a11y-max: -10;
            changed(v) => { root.fx(0, v); }
        }
        Knob {
            size: 40px;
            label: "Comp";
            value: root.data.comp;
            default-value: 0;
            active: root.data.comp > 0.005;
            value-text: root.data.comp < 0.005 ? "off" : round(root.data.comp * 100) / 10;
            a11y-label: root.data.name + " compressor amount";
            a11y-value: root.data.comp * 10;
            a11y-min: 0;
            a11y-max: 10;
            changed(v) => { root.fx(1, v); }
        }
    }
    HorizontalLayout {
        alignment: space-between;
        vertical-stretch: 0;
        Knob {
            size: 32px;
            label: "Low";
            value: root.data.low;
            default-value: 0.5;
            active: abs(root.data.low - 0.5) > 0.01;
            value-text: root.eq-text(root.data.low);
            a11y-label: root.data.name + " low EQ";
            a11y-value: root.data.low * 24 - 12;
            a11y-min: -12;
            a11y-max: 12;
            changed(v) => { root.fx(2, v); }
        }
        Knob {
            size: 32px;
            label: "Mid";
            value: root.data.mid;
            default-value: 0.5;
            active: abs(root.data.mid - 0.5) > 0.01;
            value-text: root.eq-text(root.data.mid);
            a11y-label: root.data.name + " mid EQ";
            a11y-value: root.data.mid * 24 - 12;
            a11y-min: -12;
            a11y-max: 12;
            changed(v) => { root.fx(3, v); }
        }
        Knob {
            size: 32px;
            label: "High";
            value: root.data.high;
            default-value: 0.5;
            active: abs(root.data.high - 0.5) > 0.01;
            value-text: root.eq-text(root.data.high);
            a11y-label: root.data.name + " high EQ";
            a11y-value: root.data.high * 24 - 12;
            a11y-min: -12;
            a11y-max: 12;
            changed(v) => { root.fx(4, v); }
        }
    }
    HorizontalLayout {
        vertical-stretch: 0;
        IndicatorButton {
            text: "Denoise";
            horizontal-stretch: 1;
            a11y-label: root.data.name + " noise suppression"
                + (root.denoise-available ? "" : " (needs the engine at 48 kHz)");
            on: root.data.denoise;
            dimmed: !root.denoise-available;
            clicked => { root.denoise(); }
        }
    }
    Rectangle { height: 1px; background: Theme.strip-border; vertical-stretch: 0; }
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        vertical-stretch: 1;
        LedMeter { level: root.meter.l; peak: root.meter.lp; }
        LedMeter { level: root.meter.r; peak: root.meter.rp; }
        Fader {
            pos: root.data.pos;
            value-text: root.data.db-text;
            value-db: root.data.db;
            label: root.data.name + " fader";
            changed(p) => { root.gain(p); }
            context-menu => { root.edit(); }
        }
        VerticalLayout {
            spacing: 5px;
            alignment: start;
            for bus[j] in root.bus-ids: IndicatorButton {
                text: bus;
                min-width: 54px;
                a11y-label: root.data.name + " to " + bus;
                on: root.data.routes[j];
                clicked => { root.route(j); }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        vertical-stretch: 0;
        IndicatorButton {
            text: "Solo";
            horizontal-stretch: 1;
            a11y-label: root.data.name + " solo";
            on: root.data.solo;
            on-color: Theme.yellow;
            on-bg: Theme.yellow-bg;
            clicked => { root.solo(); }
        }
        IndicatorButton {
            text: "Mute";
            horizontal-stretch: 1;
            a11y-label: root.data.name + " mute";
            on: root.data.mute;
            on-color: Theme.red;
            on-bg: Theme.red-bg;
            clicked => { root.mute(); }
        }
    }
}

export component BusStrip inherits StripFrame {
    in property <StripView> data;
    in property <MeterView> meter;
    callback gain(float);
    callback mute();
    callback keep-awake();
    width: 140px;
    kind: "output";
    removable: !root.data.master;
    name: root.data.name;
    device: root.data.device;
    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        vertical-stretch: 1;
        LedMeter { level: root.meter.l; peak: root.meter.lp; }
        LedMeter { level: root.meter.r; peak: root.meter.rp; }
        Fader {
            pos: root.data.pos;
            value-text: root.data.db-text;
            value-db: root.data.db;
            label: root.data.name + " fader";
            changed(p) => { root.gain(p); }
            context-menu => { root.edit(); }
        }
    }
    HorizontalLayout {
        vertical-stretch: 0;
        IndicatorButton {
            text: "Keep awake";
            horizontal-stretch: 1;
            a11y-label: root.data.name + " keep speakers awake (inaudible tone after 10 s of silence)";
            on: root.data.keep-awake;
            clicked => { root.keep-awake(); }
        }
    }
    HorizontalLayout {
        vertical-stretch: 0;
        IndicatorButton {
            text: "Mute";
            horizontal-stretch: 1;
            a11y-label: root.data.name + " mute";
            on: root.data.mute;
            on-color: Theme.red;
            on-bg: Theme.red-bg;
            clicked => { root.mute(); }
        }
    }
}

component Section inherits Rectangle {
    in property <string> title;
    border-radius: 12px;
    background: Theme.section;
    border-width: 1px;
    border-color: Theme.section-border;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Text {
            text: root.title;
            font-size: Theme.font-small;
            font-weight: 600;
            letter-spacing: 1.2px;
            color: Theme.text-dim;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            vertical-stretch: 1;
            @children
        }
    }
}

export component MixerView inherits HorizontalLayout {
    in property <[StripView]> strips;
    in property <[MeterView]> strip-meters;
    in property <[StripView]> buses;
    in property <[MeterView]> bus-meters;
    in property <[string]> bus-ids;
    // Choices offered by the device pickers (the same for every strip/bus).
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    callback strip-gain(int, float);
    callback strip-mute(int);
    callback strip-solo(int);
    callback strip-route(int, int);
    callback strip-fx(int, int, float);
    callback strip-denoise(int);
    callback bus-keep-awake(int);
    in property <bool> denoise-available: true;
    callback strip-device(int, int);
    callback strip-rename(int, string);
    callback strip-remove(int);
    callback add-strip();
    callback bus-gain(int, float);
    callback bus-mute(int);
    callback bus-device(int, int);
    callback bus-rename(int, string);
    callback bus-remove(int);
    callback add-bus();
    spacing: 10px;
    alignment: start;
    Section {
        title: "INPUTS";
        for s[i] in root.strips: InputStrip {
            data: s;
            meter: root.strip-meters[i];
            bus-ids: root.bus-ids;
            device-options: root.input-devices;
            gain(p) => { root.strip-gain(i, p); }
            mute => { root.strip-mute(i); }
            solo => { root.strip-solo(i); }
            route(b) => { root.strip-route(i, b); }
            fx(kind, v) => { root.strip-fx(i, kind, v); }
            denoise => { root.strip-denoise(i); }
            denoise-available: root.denoise-available;
            device-selected(d) => { root.strip-device(i, d); }
            rename(n) => { root.strip-rename(i, n); }
            remove => { root.strip-remove(i); }
        }
        AddCard {
            text: "Add input";
            clicked => { root.add-strip(); }
        }
    }
    Section {
        title: "OUTPUTS";
        for b[i] in root.buses: BusStrip {
            data: b;
            meter: root.bus-meters[i];
            device-options: root.output-devices;
            gain(p) => { root.bus-gain(i, p); }
            mute => { root.bus-mute(i); }
            keep-awake => { root.bus-keep-awake(i); }
            device-selected(d) => { root.bus-device(i, d); }
            rename(n) => { root.bus-rename(i, n); }
            remove => { root.bus-remove(i); }
        }
        AddCard {
            text: "Add output";
            clicked => { root.add-bus(); }
        }
    }
}
