import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// Segmented LED meter. `level` and `peak` are 0..1 (bottom..top).
export component LedMeter inherits Rectangle {
    in property <float> level;
    in property <float> peak;
    property <int> segments: 30;
    property <int> lit: floor(clamp(root.level, 0, 1) * root.segments);
    property <int> peak-seg: min(root.segments - 1, floor(clamp(root.peak, 0, 1) * root.segments));
    property <length> seg-h: (root.height - (root.segments - 1) * 2px) / root.segments;
    width: 8px;
    for i in root.segments: Rectangle {
        x: 0;
        width: root.width;
        height: root.seg-h;
        y: root.height - (i + 1) * (root.seg-h + 2px) + 2px;
        border-radius: 1px;
        background: (i < root.lit || (i == root.peak-seg && root.peak > 0.01))
            ? (i >= root.segments * 0.86 ? Theme.red : i >= root.segments * 0.7 ? Theme.yellow : Theme.green)
            : Theme.led-off;
    }
}

// Fader with a wide track and a round knob showing the value. `pos` is
// 0..1. Drag, mouse wheel or arrow keys change it; double-click resets.
export component Fader inherits FocusScope {
    in property <float> pos;
    // Unity gain on the fader law in src/fader_law.rs.
    in property <float> default-pos: 0.8333;
    in property <string> value-text;
    in property <string> label;
    in property <float> step: 1 / 72;
    // One mouse-wheel notch: 2 dB.
    in property <float> wheel-step: 2 / 72;
    // Accessible value in dB (numeric, so screen readers get a range).
    in property <float> value-db;
    callback changed(float);
    // Right click (rename / remove menu).
    callback context-menu();
    property <length> knob: 40px;
    width: 40px;
    min-height: 140px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value-db);
    accessible-value-minimum: -60;
    accessible-value-maximum: 12;
    accessible-value-step: 1;
    accessible-action-increment => { root.changed(clamp(root.pos + root.step, 0, 1)); }
    accessible-action-decrement => { root.changed(clamp(root.pos - root.step, 0, 1)); }
    key-pressed(e) => {
        if (e.text == Key.UpArrow) { root.changed(clamp(root.pos + root.step, 0, 1)); return accept; }
        if (e.text == Key.DownArrow) { root.changed(clamp(root.pos - root.step, 0, 1)); return accept; }
        reject
    }
    function at(y: length) -> float {
        clamp(1 - (y - root.knob / 2) / (root.height - root.knob), 0, 1)
    }
    Rectangle {
        x: (root.width - 14px) / 2;
        width: 14px;
        background: Theme.track;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 7px;
    }
    Rectangle {
        x: (root.width - 12px) / 2;
        width: 12px;
        y: (root.height - root.knob) * (1 - root.pos) + root.knob / 2;
        height: max(0px, root.height - self.y - 1px);
        background: Theme.accent-fill;
        border-radius: 6px;
    }
    Rectangle {
        width: root.knob;
        height: root.knob;
        y: (root.height - root.knob) * (1 - root.pos);
        border-radius: root.knob / 2;
        background: Theme.knob;
        border-width: 3px;
        border-color: root.has-focus ? Theme.text : Theme.accent;
        Text {
            text: root.value-text;
            font-size: 11px;
            font-weight: 700;
            color: Theme.knob-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.focus();
                root.changed(root.at(self.mouse-y));
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.context-menu();
            }
        }
        moved => {
            if (self.pressed) { root.changed(root.at(self.mouse-y)); }
        }
        scroll-event(e) => {
            root.changed(clamp(root.pos + (e.delta-y > 0 ? root.wheel-step : -root.wheel-step), 0, 1));
            accept
        }
        double-clicked => { root.changed(root.default-pos); }
    }
}

// Rounded toggle button with an indicator light.
export component IndicatorButton inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <color> on-color: Theme.accent;
    in property <color> on-bg: Theme.accent-bg;
    // Full name for screen readers, e.g. "Mic mute" (defaults to the text).
    in property <string> a11y-label: root.text;
    // Shown faded (the feature is unavailable); clicks still arrive so the
    // app can explain why.
    in property <bool> dimmed: false;
    callback clicked();
    height: 26px;
    min-width: 50px;
    opacity: root.dimmed ? 0.45 : 1.0;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.on ? root.on-color : (touch.has-hover ? Theme.text-dim : Theme.button-border);
    background: root.on ? root.on-bg : (touch.has-hover ? Theme.button-hover : Theme.button);
    accessible-role: checkbox;
    accessible-label: root.a11y-label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.on ? root.on-color : Theme.indicator-off;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            color: root.on ? Theme.text : Theme.text-mid;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pill-shaped tab button.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : (touch.has-hover ? Theme.text-dim : Theme.line);
    background: root.active ? Theme.accent-bg : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: Theme.font;
            color: root.active ? Theme.text : Theme.text-mid;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Title-bar button. kind: 0 minimise, 1 maximise, 2 restore, 3 close.
export component WindowButton inherits Rectangle {
    in property <int> kind;
    in property <string> a11y-label;
    in property <color> hover-color: Theme.button-hover;
    callback clicked();
    width: 46px;
    background: touch.has-hover ? root.hover-color : transparent;
    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-action-default => { root.clicked(); }
    Path {
        x: (root.width - 10px) / 2;
        y: (root.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: touch.has-hover ? Theme.text : Theme.text-mid;
        stroke-width: 1px;
        commands: root.kind == 0 ? "M 0 5 L 10 5"
            : root.kind == 1 ? "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
            : root.kind == 2 ? "M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z"
            : "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Device selector: shows the current device; click opens a list.
export component DeviceSelect inherits Rectangle {
    in property <string> text;
    in property <[string]> options;
    in property <string> a11y-label;
    callback selected(int);
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.text-dim : Theme.button-border;
    background: Theme.button;
    accessible-role: combobox;
    accessible-label: root.a11y-label;
    accessible-value: root.text;
    accessible-action-default => { popup.show(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.text;
            font-size: Theme.font-small;
            color: Theme.text-mid;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "▾";
            font-size: 11px;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 460px);
        height: min(root.options.length * 30px + 10px, 560px);
        Rectangle {
            background: Theme.popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.strip-border;
            ScrollView {
                VerticalLayout {
                    padding: 5px;
                    for option[i] in root.options: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: item.has-hover ? Theme.accent-bg : transparent;
                        accessible-role: list-item;
                        accessible-label: option;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: option;
                                font-size: Theme.font;
                                color: option == root.text ? Theme.accent : Theme.text;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        item := TouchArea {
                            clicked => {
                                root.selected(i);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// Rotary knob. `value` is 0..1; drag up/down, mouse wheel or arrow keys
// change it, double-click resets to `default-value`.
export component Knob inherits FocusScope {
    in property <float> value;
    in property <float> default-value;
    in property <string> label;
    in property <string> value-text;
    in property <bool> active;
    in property <length> size: 40px;
    // Screen readers get the value in real units.
    in property <string> a11y-label;
    in property <float> a11y-value;
    in property <float> a11y-min;
    in property <float> a11y-max;
    callback changed(float);
    property <float> step: 0.02;
    property <length> drag-y;
    property <float> drag-value;
    property <angle> angle: -225deg + 270deg * clamp(root.value, 0, 1);
    width: root.size + 14px;
    vertical-stretch: 0;
    accessible-role: slider;
    accessible-label: root.a11y-label;
    accessible-value: round(root.a11y-value * 10) / 10;
    accessible-value-minimum: root.a11y-min;
    accessible-value-maximum: root.a11y-max;
    accessible-action-increment => { root.changed(clamp(root.value + root.step, 0, 1)); }
    accessible-action-decrement => { root.changed(clamp(root.value - root.step, 0, 1)); }
    key-pressed(e) => {
        if (e.text == Key.UpArrow || e.text == Key.RightArrow) { root.changed(clamp(root.value + root.step, 0, 1)); return accept; }
        if (e.text == Key.DownArrow || e.text == Key.LeftArrow) { root.changed(clamp(root.value - root.step, 0, 1)); return accept; }
        reject
    }
    VerticalLayout {
        spacing: 2px;
        alignment: start;
        Text { text: root.label; font-size: Theme.font-small; color: Theme.text-dim; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.size;
                height: root.size;
                Rectangle {
                    x: root.size * 0.15;
                    y: root.size * 0.15;
                    width: root.size * 0.7;
                    height: root.size * 0.7;
                    border-radius: self.width / 2;
                    background: Theme.track;
                    border-width: 1px;
                    border-color: root.has-focus ? Theme.text-dim : Theme.line;
                }
                Path {
                    width: root.size;
                    height: root.size;
                    viewbox-width: 34;
                    viewbox-height: 34;
                    stroke: Theme.line;
                    stroke-width: 3.5px;
                    commands: "M 7.81 26.19 A 13 13 0 1 1 26.19 26.19";
                }
                if root.value > 0.005: Path {
                    width: root.size;
                    height: root.size;
                    viewbox-width: 34;
                    viewbox-height: 34;
                    stroke: root.active ? Theme.accent : Theme.indicator-off;
                    stroke-width: 3.5px;
                    commands: "M 7.81 26.19 A 13 13 0 " + (root.value > 0.6667 ? "1" : "0") + " 1 "
                        + (17 + 13 * cos(root.angle)) + " " + (17 + 13 * sin(root.angle));
                }
                Path {
                    width: root.size;
                    height: root.size;
                    viewbox-width: 34;
                    viewbox-height: 34;
                    stroke: Theme.knob;
                    stroke-width: 2.5px;
                    commands: "M " + (17 + 2 * cos(root.angle)) + " " + (17 + 2 * sin(root.angle)) + " L "
                        + (17 + 8.5 * cos(root.angle)) + " " + (17 + 8.5 * sin(root.angle));
                }
            }
        }
        Text { text: root.value-text; font-size: Theme.font-small; color: root.active ? Theme.text : Theme.text-dim; horizontal-alignment: center; }
    }
    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.focus();
                root.drag-y = self.mouse-y;
                root.drag-value = root.value;
            }
        }
        moved => {
            if (self.pressed) {
                // 150 px of travel covers the whole range.
                root.changed(clamp(root.drag-value + (root.drag-y - self.mouse-y) / 150px, 0, 1));
            }
        }
        scroll-event(e) => {
            root.changed(clamp(root.value + (e.delta-y > 0 ? root.step : -root.step), 0, 1));
            accept
        }
        double-clicked => { root.changed(root.default-value); }
    }
}
