import { Theme } from "theme.slint";
import { PillButton, DeviceSelect } from "controls.slint";
import { Segmented, Section, Row, Divider } from "settings.slint";
import { ScrollView } from "std-widgets.slint";

// What the user did on the Hotkeys tab; the value is a shortcut id, an
// option index or a bool (0/1).
export enum HotkeyEvent {
    add,
    edit,
    remove,
    test,
    record,
    save,
    cancel,
    action,
    target,
    step,
    hold,
    feedback-bus,
    feedback-level,
}

// One shortcut in the list.
export struct HotkeyRow {
    id: int,
    keys: string,
    // "Mute Mikro", "Main +3 dB" …
    action: string,
    // "" or "While held".
    mode: string,
    // Why the shortcut does not fire (another app uses the keys …).
    error: string,
}

// The shortcut being added or edited.
export struct HotkeyEditor {
    open: bool,
    // 0: a new shortcut.
    id: int,
    keys: string,
    // Waiting for the user to press keys.
    recording: bool,
    // 0 mute input, 1 solo input, 2 input volume, 3 mute output, 4 output volume.
    action: int,
    targets: [string],
    target: int,
    target-text: string,
    // Index into the volume steps (-6, -3, -1, +1, +3, +6 dB).
    step: int,
    hold: bool,
    // Shown under the keys (e.g. why they cannot be used).
    error: string,
}

export struct HotkeysState {
    // Global shortcuts work on this system.
    available: bool,
    note: string,
    // The connected engine predates shortcuts.
    engine-outdated: bool,
    rows: [HotkeyRow],
    editor: HotkeyEditor,
    feedback-options: [string],
    feedback-text: string,
    // 0 quiet, 1 medium, 2 loud, -1 something else (set in the file).
    level: int,
}

// The key combination of a shortcut, drawn like a keycap.
component Keys inherits Rectangle {
    in property <string> text;
    in property <bool> highlight;
    height: 26px;
    min-width: 90px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.highlight ? Theme.accent : Theme.button-border;
    background: Theme.track;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: Theme.font;
            font-weight: 600;
            color: root.highlight ? Theme.accent : Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A small text button inside a row.
component LinkButton inherits Rectangle {
    in property <string> text;
    in property <color> hover: Theme.text;
    callback clicked();
    height: 26px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.button-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 12px;
            color: touch.has-hover ? root.hover : Theme.text-mid;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Editor inherits Rectangle {
    in property <HotkeyEditor> editor;
    callback event(HotkeyEvent, int);
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.accent;
    background: Theme.strip;
    VerticalLayout {
        padding: 14px;
        spacing: 14px;
        Text {
            text: root.editor.id == 0 ? "New shortcut" : "Edit shortcut";
            font-weight: 600;
            color: Theme.text;
        }
        Row {
            title: "Keys";
            detail: root.editor.error != "" ? root.editor.error
                : root.editor.recording ? "Press the combination now, anywhere. Escape cancels."
                : "Use Ctrl, Alt or Win with a letter or digit, or a key like F13 to F24, Pause or the numpad.";
            detail-color: root.editor.error != "" ? Theme.yellow : Theme.text-dim;
            HorizontalLayout {
                spacing: 8px;
                Keys {
                    text: root.editor.recording ? "Press keys…" : (root.editor.keys == "" ? "None" : root.editor.keys);
                    highlight: root.editor.recording;
                }
                PillButton {
                    text: root.editor.recording ? "Recording…" : "Record";
                    active: root.editor.recording;
                    clicked => { root.event(HotkeyEvent.record, 0); }
                }
            }
        }
        Divider { }
        Row {
            title: "Action";
            Segmented {
                options: ["Mute input", "Solo input", "Input volume", "Mute output", "Output volume"];
                selected: root.editor.action;
                a11y-label: "Action";
                activated(i) => { root.event(HotkeyEvent.action, i); }
            }
        }
        Row {
            title: root.editor.action <= 2 ? "Input" : "Output";
            DeviceSelect {
                width: 240px;
                text: root.editor.target-text;
                options: root.editor.targets;
                a11y-label: root.editor.action <= 2 ? "Input strip" : "Output bus";
                selected(i) => { root.event(HotkeyEvent.target, i); }
            }
        }
        if root.editor.action == 2 || root.editor.action == 4: Row {
            title: "Step";
            detail: "Each press moves the fader by this much.";
            Segmented {
                options: ["-6 dB", "-3 dB", "-1 dB", "+1 dB", "+3 dB", "+6 dB"];
                selected: root.editor.step;
                a11y-label: "Volume step";
                activated(i) => { root.event(HotkeyEvent.step, i); }
            }
        }
        if root.editor.action != 2 && root.editor.action != 4: Row {
            title: "Mode";
            detail: root.editor.hold
                ? "Switches while the keys are held and back on release: push-to-talk on a muted input, push-to-mute on an open one."
                : "Each press switches on or off.";
            Segmented {
                options: ["Toggle", "While held"];
                selected: root.editor.hold ? 1 : 0;
                a11y-label: "Mode";
                activated(i) => { root.event(HotkeyEvent.hold, i); }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            PillButton { text: "Cancel"; clicked => { root.event(HotkeyEvent.cancel, 0); } }
            PillButton {
                text: "Save";
                active: root.editor.keys != "" && !root.editor.recording;
                clicked => { root.event(HotkeyEvent.save, 0); }
            }
        }
    }
}

export component HotkeysView inherits ScrollView {
    in property <HotkeysState> state;
    in property <bool> connected;
    callback event(HotkeyEvent, int);

    VerticalLayout {
        padding-bottom: 4px;
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                horizontal-stretch: 100;
                max-width: 860px;
                spacing: 12px;
                alignment: start;

                Section {
                    title: "KEYBOARD SHORTCUTS";
                    if !root.connected: Row {
                        title: "The audio engine isn't running";
                        detail: "Shortcuts are handled by the engine, so they also work while this window is closed. Start it to edit them.";
                    }
                    if root.connected && root.state.engine-outdated: Row {
                        title: "The running engine is an older version";
                        detail: "Stop and start it (tray menu) to use shortcuts.";
                    }
                    if root.connected && !root.state.engine-outdated && !root.state.available: Row {
                        title: "Shortcuts don't work on this system yet";
                        detail: root.state.note;
                        detail-color: Theme.yellow;
                    }
                    if root.connected && !root.state.engine-outdated: Text {
                        text: "Shortcuts work in the background, also while a game or another app has the focus.";
                        font-size: 12px;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    if root.connected && !root.state.engine-outdated && root.state.rows.length == 0 && !root.state.editor.open: Text {
                        text: "No shortcuts yet.";
                        color: Theme.text-mid;
                    }
                    if root.connected && !root.state.engine-outdated: VerticalLayout {
                        spacing: 6px;
                        for row in root.state.rows: Rectangle {
                            border-radius: 8px;
                            background: Theme.strip;
                            border-width: 1px;
                            border-color: root.state.editor.open && root.state.editor.id == row.id ? Theme.accent : Theme.strip-border;
                            HorizontalLayout {
                                padding: 8px;
                                padding-left: 10px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    Keys { text: row.keys; width: 170px; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: row.mode == "" ? row.action : row.action + "  ·  " + row.mode;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    if row.error != "": Text {
                                        text: row.error;
                                        font-size: 12px;
                                        color: Theme.yellow;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 2px;
                                        LinkButton { text: "Test"; clicked => { root.event(HotkeyEvent.test, row.id); } }
                                        LinkButton { text: "Edit"; clicked => { root.event(HotkeyEvent.edit, row.id); } }
                                        LinkButton {
                                            text: "Remove";
                                            hover: Theme.red;
                                            clicked => { root.event(HotkeyEvent.remove, row.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.connected && !root.state.engine-outdated && root.state.editor.open: Editor {
                        editor: root.state.editor;
                        event(kind, value) => { root.event(kind, value); }
                    }
                    if root.connected && !root.state.engine-outdated && !root.state.editor.open: HorizontalLayout {
                        alignment: start;
                        PillButton { text: "Add shortcut"; active: true; clicked => { root.event(HotkeyEvent.add, 0); } }
                    }
                }

                if root.connected && !root.state.engine-outdated: Section {
                    title: "CONFIRMATION TONE";
                    Row {
                        title: "Play a tone on";
                        detail: "A short rising tone when something is switched on or up, a falling one when it is switched off or down. Choose the output you listen on, not one other apps record from (such as the one Discord uses as your microphone).";
                        DeviceSelect {
                            width: 240px;
                            text: root.state.feedback-text;
                            options: root.state.feedback-options;
                            a11y-label: "Confirmation tone output";
                            selected(i) => { root.event(HotkeyEvent.feedback-bus, i); }
                        }
                    }
                    Divider { }
                    Row {
                        title: "Volume";
                        Segmented {
                            options: ["Quiet", "Medium", "Loud"];
                            selected: root.state.level;
                            a11y-label: "Confirmation tone volume";
                            activated(i) => { root.event(HotkeyEvent.feedback-level, i); }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
