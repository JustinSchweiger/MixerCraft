// Colours and metrics shared by every component. Change the look here.
// A slate-blue console palette with mint accents.
export global Theme {
    // Surfaces
    out property <color> bg: #1e2730;
    out property <color> titlebar: #182028;
    out property <color> section: #25303b;
    out property <color> section-border: #33404d;
    out property <color> strip: #2d3946;
    out property <color> strip-border: #3c4a59;
    out property <color> strip-header: #344352;
    // Text
    out property <color> text: #f1f5f9;
    out property <color> text-mid: #c3cdd8;
    out property <color> text-dim: #8b9aab;
    // Accent (routes, active knobs, fader fill)
    out property <color> accent: #6fd6b0;
    out property <color> accent-bg: #23493f;
    out property <color> accent-fill: #3f9f80;
    // Controls
    out property <color> track: #172028;
    out property <color> line: #455566;
    out property <color> button: #26313c;
    out property <color> button-hover: #31404e;
    out property <color> button-border: #4a5a6b;
    out property <color> led-off: #222c36;
    out property <color> indicator-off: #4b5866;
    out property <color> knob: #eef4f2;
    out property <color> knob-text: #12201b;
    out property <color> popup: #2a3642;
    // Signal colours
    out property <color> green: #4fd18b;
    out property <color> yellow: #f4c955;
    out property <color> yellow-bg: #4a4224;
    out property <color> red: #ff6f62;
    out property <color> red-bg: #4d2b2a;
    out property <color> close-hover: #c4413a;
    // Metrics
    out property <length> radius: 8px;
    out property <length> font: 13px;
    out property <length> font-small: 11px;
    out property <length> font-title: 15px;
}
