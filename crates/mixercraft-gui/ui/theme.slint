// Colours and metrics shared by every component. Change the look here.
export global Theme {
    out property <color> bg: #121418;
    out property <color> section: #181b21;
    out property <color> section-border: #23272f;
    out property <color> strip: #1d2128;
    out property <color> strip-border: #272c35;
    out property <color> text: #eef1f5;
    out property <color> text-mid: #aab2bd;
    out property <color> text-dim: #7c8592;
    out property <color> accent: #7ab8ff;
    out property <color> accent-bg: #1f2d40;
    out property <color> accent-fill: #2e5d8f;
    out property <color> track: #11141a;
    out property <color> line: #2c313a;
    out property <color> button: #1a1e25;
    out property <color> button-hover: #222730;
    out property <color> button-border: #303641;
    out property <color> led-off: #232831;
    out property <color> indicator-off: #3a404b;
    out property <color> knob: #e9edf2;
    out property <color> knob-text: #14181e;
    out property <color> green: #46c47a;
    out property <color> yellow: #f2c14e;
    out property <color> yellow-bg: #3a321c;
    out property <color> red: #ff6b5f;
    out property <color> red-bg: #3a1f1e;
    out property <length> radius: 8px;
}
